.modal.fade(id="pugModal" tabindex="-1")
  .modal-dialog 
    .modal-content 
      .modal-header 
        h5.modal-title(id="pugModalTitle") Title
        button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
      .modal-body(id="pugModalBody")
      .modal-footer 
        button.btn.btn-primary(data-bs-dismiss="modal") Close
