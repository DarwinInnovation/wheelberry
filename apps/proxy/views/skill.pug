doctype html
html 
  head 
    title= skillName
    include includes/bootstrap_head.pug
  body
    .container-fluid 
      nav.navbar.navbar-expand-md.navbar-dark.bg-dark 
        .container-fluid 
          .navbar-brand#skill= skillName

      .container-fluid    
        .row
          each intent, intentName in intents 
            .col-md-3
              .card 
                .card-body
                  h5.card-title= intentName 
                p.card-text= intent.intent.slots
                a.btn.btn-primary.intent(href="#" id=intentName)= intentName

    include includes/modal.pug

    include includes/bootstrap_body.pug
    script(src="/scripts/skill.js")
