# MongoDB connection string (local for dev, Atlas URI for production)
MONGODB_URI=mongodb://localhost:27017/wheelberry

# Session secret (generate a random string: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-secret

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=/auth/google/callback

# Amazon OAuth 2.0 (https://developer.amazon.com/loginwithamazon/console/site/lwa/overview.html)
# AMAZON_CLIENT_ID=
# AMAZON_CLIENT_SECRET=
# AMAZON_CALLBACK_URL=/auth/amazon/callback

# Server
PORT=9887
APP_ID=wheelberry-proxy
LOG_LEVEL=info
# NODE_ENV=production
