{
  "name": "@wheelberry/proxy",
  "version": "1.0.1",
  "private": true,
  "description": "Wheelberry proxy server — routes Alexa/web commands to IoT devices via Socket.IO.",
  "main": "bin/index.js",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "build": "tsc && pnpm --filter @wheelberry/portal build",
    "typecheck": "tsc --noEmit",
    "start": "node bin/index.js",
    "dev": "LOG_LEVEL=debug tsx watch src/index.ts | pino-pretty",
    "dev:portal": "pnpm --filter @wheelberry/portal dev",
    "clean": "rm -rf bin"
  },
  "dependencies": {
    "@wheelberry/proxy-client": "workspace:*",
    "args": "^5.0.3",
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-express-adapter": "^2.14.0",
    "ask-sdk-model": "^1.86.0",
    "axios": "^1.13.6",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "json5": "^2.2.3",
    "lodash": "^4.17.23",
    "mongoose": "^9.2.4",
    "passport": "^0.7.0",
    "passport-amazon": "^1.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.3.1",
    "pug": "^3.0.3",
    "rand-token": "^1.0.1",
    "socket.io": "^4.8.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/args": "^5.0.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.2",
    "@types/lodash": "^4.17.24",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3"
  }
}
