# Environment variables for node-wheelberry-wheelchair

# Bearer token for authenticating with the proxy server
# Generate via: npx tsx ../node-wheelberry-proxy/src/scripts/admin-cli.ts token generate <device-uid>
WHEELBERRY_TOKEN=

# URL of the Wheelberry proxy server (e.g. http://localhost:3000)
WHEELBERRY_PROXY_URL=

# Optional: application identifier shown in logs
APP_ID=wheelchair

# Optional: pino log level (default: info)
LOG_LEVEL=info
